{
  "name": "hanko-kana",
  "private": true,
  "description": "Outils de développement de Hanko (tests). Le site lui-même n'a aucune dépendance.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node tests/server.mjs",
    "test": "npm run test:unit && playwright test",
    "test:unit": "TZ=Europe/Paris node --test 'tests/unit/*.test.js'",
    "test:logique": "playwright test --project=logique",
    "golden": "UPDATE_GOLDEN=1 playwright test --project=logique",
    "build": "node scripts/build.mjs",
    "build:claude": "node scripts/build-claude.mjs",
    "lint": "eslint . && tsc -p jsconfig.json && prettier --check \"src/**/*.js\" sw.js styles.css \"scripts/**/*.mjs\" \"tests/**/*.{js,mjs}\" \"*.config.js\" \"types/**/*.ts\"",
    "format": "prettier --write \"src/**/*.js\" sw.js styles.css \"scripts/**/*.mjs\" \"tests/**/*.{js,mjs}\" \"*.config.js\" \"types/**/*.ts\"",
    "typecheck": "tsc -p jsconfig.json",
    "fonts": "node scripts/fonts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "harfbuzzjs": "1.6.4",
    "prettier": "3.10.1",
    "subset-font": "2.9.0",
    "typescript": "7.0.2",
    "wawoff2": "2.0.1"
  }
}
